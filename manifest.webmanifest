{
  "id": "./",
  "name": "Tabbed PDF",
  "short_name": "Tabbed PDF",
  "description": "Open, create, annotate, sign and export PDF files locally in your browser.",
  "lang": "en",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#D4D0C8",
  "theme_color": "#0A246A",
  "icons": [
    {
      "src": "icons/tabbed-pdf-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/tabbed-pdf-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/pdf": [
          ".pdf"
        ]
      }
    }
  ]
}
